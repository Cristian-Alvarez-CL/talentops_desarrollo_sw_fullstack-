# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskflow
DB_USER=postgres
DB_PASSWORD=change_this_secure_password

# JWT Configuration (Generate secure secrets for production!)
# Use: openssl rand -base64 64
JWT_SECRET=your_super_secure_jwt_secret_at_least_64_characters_long_change_me
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_at_least_64_characters_long_change_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Server Configuration
NODE_ENV=production
PORT=5000

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# CORS Configuration
CORS_ORIGIN=http://localhost
